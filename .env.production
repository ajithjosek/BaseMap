NODE_ENV=production
PORT=4000

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/basemap?schema=public

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Elasticsearch
ELASTICSEARCH_NODE=http://elasticsearch:9200

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=basemap123

# Auth - MUST be overridden with strong secrets in production
JWT_SECRET=change-me-production-jwt-secret
JWT_REFRESH_SECRET=change-me-production-refresh-secret

# Storage
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=basemap-assets

# App
APP_URL=https://basemap.io

# Billing (set real Stripe keys in production secrets)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=